<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sign in — Memento</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<section class="screen active" id="login">
  <div class="auth-wrap">
    <div class="auth-card">

      <div class="auth-brand">Me<span>mento</span></div>

      <h1>Welcome back</h1>
      <p class="sub">Log in to keep reading and writing.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

<form action="/login" method="POST">

      <div class="field"><label>Email</label><input
  type="email"
  name="email"
  placeholder="you@example.com"
  required
></div>
      <div class="field"><label>Password</label><input
  type="password"
  name="password"
  placeholder="••••••••"
  required
></div>
     <button
  type="submit"
  class="btn btn-primary"
  style="width:100%; justify-content:center;"
>
  Sign in
</button>
</form>
<div class="divider">
    <span>OR</span>
</div>
<a href="/auth/google" class="google-btn">
    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google">
    <span>Continue with Google</span>
</a>
      <p class="foot-link">New here? <a href="/register">Create an account</a></p>
    </div>
  </div>
</section>

</body>
</html>