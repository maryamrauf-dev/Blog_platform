<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Inkly — UI mockup</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<section class="screen active" id="create">
  <%- include("partials/navbar") %>
  <div class="form-page" style="max-width:640px; margin:0 auto;">
    <h1 class="serif">Create new article</h1>
   <form action="/articles" method="POST">

  <div class="field">
    <label>Title</label>

    <input
      type="text"
      name="title"
      placeholder="Give your article a clear title"
      required
    >
  </div>

  <div class="field">
    <label>Short description</label>

    <textarea
      name="description"
      rows="2"
      placeholder="One or two sentences that summarize it"
      required
    ></textarea>
  </div>

  <div class="field">
    <label>Content</label>

    <textarea
      name="content"
      rows="10"
      placeholder="Write your article here..."
      required
    ></textarea>
  </div>

  <div class="form-actions">

    <a href="/my-articles" class="btn">
      Cancel
    </a>

    <button
      type="submit"
      class="btn btn-primary"
    >
      Publish
    </button>

  </div>

</form>
  </div>
  <%- include("partials/footer") %>
</section>
</body>
</html>